---
import "../styles/global.css";
import Card from "./Card.astro";
---

<section class="projects">
  <section class="pj-content">
    <section class="pj-top">
      <span>01 - mi trabajo</span>
      <h2>Proyectos seleccionados</h2>
      <p class="pj-desc">¡Puedes ver su codigo y más informacion en Github!</p>
    </section>
    <div class="pj-container-cards"></div>
  </section>
</section>

<style>
  .projects {
    max-width: calc(100% - 35%);
    margin: 0 auto;
    padding: 5em 2em;
  }

  .pj-top {
    margin-left: calc(100% - 92.5%);
    margin-bottom: 2em;

    & span {
      font-family: var(--font-terminal-style);
      font-size: 0.8rem;
      color: var(--color-accent);
    }

    & h2 {
      font-family: var(--font-titles);
      margin-bottom: 0;
      margin-top: 0em;
    }
  }

  .pj-desc {
    font-family: var(--font-body);
    margin-top: 0em;
  }
</style>
