---
import "../styles/global.css";
const { title, href } = Astro.props;
---

<a href={href} class="secundary-btn">{title}</a>

<style>
  .secundary-btn {
    font-family: var(--font-body);
    padding: 0.5em 1.5em;
    text-decoration: none;
    border: 1px solid var(--color-text);
    border-radius: 0.4em;
    color: var(--color-text);
  }
</style>
