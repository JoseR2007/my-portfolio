---
import "../styles/global.css";
import PrimaryBtn from "./PrimaryBtn.astro";
import SecundaryBtn from "./SecundaryBtn.astro";
---

<section class="presentation">
  <section class="pt-content">
    <div class="pt-name">
      <span>~/jose-rafael</span>
    </div>
    <div class="pt-top">
      <h1>Construyendo software con</h1>
      <h1 class="pt-h1-enfasis">atención al detalle</h1>
      <p>
        Lorem ipsum, dolor sit amet consectetur adipisicing elit. Optio quam
        expedita placeat maxime, fuga nihil quia veniam voluptatibus ex quaerat
        explicabo provident mollitia, dicta illo soluta velit cupiditate aperiam
        quod.
      </p>
    </div>
    <div class="pt-container-btns">
      <PrimaryBtn title="Ver proyectos" href="/" />
      <SecundaryBtn title="Contact" href="/" />
    </div>
  </section>
</section>

<style>
  .presentation {
    max-width: calc(100% - 45%);
    margin: 0 auto;
    padding: 5em 2em;
  }

  .pt-name {
    background-color: var(--color-text);
    padding: 0.1em 0.5em;
    width: max-content;
    border-radius: 0.2em;
  }

  .pt-name > span {
    font-family: var(--font-terminal-style);
    color: var(--color-text-secundary);
    font-size: 0.9rem;
  }

  .pt-top {
    margin-bottom: 3em;
  }

  .pt-top > p {
    font-family: var(--font-body);
  }

  .pt-top > h1 {
    font-family: var(--font-titles);
    margin: 0;
    font-size: 2.7rem;
  }

  .pt-h1-enfasis {
    color: var(--color-accent);
  }

  .pt-container-btns {
    display: flex;
    flex-direction: row;
    gap: 1em;
  }
</style>
