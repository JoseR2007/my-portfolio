---
import "../styles/global.css";
const { title, href } = Astro.props;
---

<a href={href} class="primary-btn">{title}</a>

<style>
  .primary-btn {
    font-family: var(--font-body);
    color: var(--color-background);
    background-color: var(--color-text);
    padding: 0.5em 1.5em;
    text-decoration: none;
    border-radius: 0.4em;
  }
</style>
